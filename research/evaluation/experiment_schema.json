{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KasaMeExperimentProvenance",
  "type": "object",
  "required": [
    "experiment_id",
    "dataset_version",
    "manifest_hash",
    "model_id",
    "model_hash",
    "model_config_hash",
    "runtime_version",
    "evaluation_script_version",
    "timestamp",
    "device_environment"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "manifest_hash": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "model_hash": {
      "type": "string"
    },
    "model_config_hash": {
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "evaluation_script_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "device_environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "python_version": { "type": "string" }
      }
    }
  }
}
